{
    "tasks": [
        {
            "label": "build statki",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-g",
                "-Iinclude",
                "Statki/src/main.cpp",
                "Statki/src/Game.cpp",
                "Statki/src/AircraftCarrier.cpp",
                "Statki/src/Board.cpp",
                "Statki/src/Cruiser.cpp",
                "Statki/src/Destroyer.cpp",
                "Statki/src/Player.cpp",
                "Statki/src/Ship.cpp",
                "Statki/src/Submarine.cpp",
                "-o",
                "statki"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ],
    "version": "2.0.0"
}